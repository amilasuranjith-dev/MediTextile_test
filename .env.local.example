# MediTex Environment Variables Template
# Copy this file to .env.local and populate with your Supabase credentials

# Supabase URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (found in Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
